# ---- Data mode ----
# "mock"  -> no real provider calls, simulated tokens (safe default, no keys needed)
# "live"  -> uses Helius + Bitquery adapters for real data
DATA_MODE=mock

# ---- Helius (Solana) ----
# Get this from https://dashboard.helius.dev -> API Keys
# NEVER put this in frontend code. Server-side only.
HELIUS_API_KEY=

# ---- Bitquery (BSC) ----
# Get this from account.bitquery.io -> Authorization -> Tokens
# (the OAuth "Access Token" generated from your app, not the app ID)
BITQUERY_ACCESS_TOKEN=

# ---- Database ----
# SQLite for local/dev. Swap for a Postgres URL in production.
DATABASE_URL=sqlite:///./early_token_prediction.db

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Feature engine tuning ----
FEATURE_TICK_MS=1000
FEATURE_WINDOW_SECONDS=600
